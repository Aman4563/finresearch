# ANTHROPIC_API_KEY=            # only if you later add an API backup
# FINRESEARCH_OLLAMA_URL=http://127.0.0.1:11434
# FINRESEARCH_MAX_FIVE_HOUR_CEILING=0.92
# FINRESEARCH_LOCAL_MIN_FREE_GB_FOR_9B=7.0
